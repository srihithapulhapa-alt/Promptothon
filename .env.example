# Server
PORT=3000
BASE_URL=http://localhost:3000
SESSION_SECRET=change-me-to-a-long-random-string
# Only used once, to import a data/db.json left by an older version into the sheet
DATA_DIR=./data

# Google OAuth. Add ${BASE_URL}/auth/callback as an authorised redirect URI. Consent screen user type must be External.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Default admin (can add more admins from the dashboard)
DEFAULT_ADMIN_EMAIL=srihitha.pulhapa@expinfi.com

# Drive/Sheets are used by the backend only. Run `npm run connect-google` once; it fills in GOOGLE_REFRESH_TOKEN below.
GOOGLE_REFRESH_TOKEN=

# Drive file IDs
QUESTION_BANK_FILE_ID=1jYPiILnJbk0yqG_h9AM6PiD6D4kJL1Pr
GAME_RULES_FILE_ID=1knJMFlyXsXr_MjWFHIplUBqv2111wk8K
# The Google Sheet that stores all data. Created automatically on the first start (its id is saved here); or set your own.
DATA_SHEET_ID=

# Claude — powers the Round 3 AI tool and rubric scoring of written answers (keyword scoring is used if empty). Backend only.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Score-card email. For Gmail / Google Workspace use an app password (2-step verification must be on). Leave empty to switch emailing off.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=The AI Club Promptathon
